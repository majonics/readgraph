    {
      "entity": "limbo",
      "depth": 1,
      "importance": 2,
      "role": "The first circle: the virtuous unbaptised, sighing but not tormented",
      "firstSection": "inf-04",
      "inBook": [
        {
          "section": "inf-04",
          "text": "Dante sees the great souls of antiquity, poets, heroes and philosophers, living in a castle of light without hope."
        }
      ],
      "media": [
