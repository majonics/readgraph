{
  "nodes": [
    {
      "entity": "dante-alighieri",
      "depth": 1,
      "importance": 3,
      "role": "The poet, and the pilgrim who walks through the poem",
      "firstSection": "inf-01",
      "inBook": [
        {
          "section": "inf-01",
          "text": "Midway through life, lost in a dark wood, he is driven back from a sunlit hill by three beasts."
        },
        {
          "section": "inf-02",
          "text": "Doubts he is worthy of the journey until Virgil tells him who sent him."
        },
        {
          "section": "inf-05",
          "text": "Faints from pity after hearing Francesca's story."
        }
      ],
      "media": []
    },
    {
      "entity": "virgil",
      "depth": 1,
      "importance": 3,
      "role": "Dante's guide through Hell",
      "firstSection": "inf-01",
      "inBook": [
        {
          "section": "inf-01",
          "text": "Appears in the dark wood and offers to lead Dante by another road."
        },
        {
          "section": "inf-02",
          "text": "Explains that Beatrice came down from Heaven to ask for his help."
        },
        {
          "section": "inf-03",
          "text": "Silences Charon: the journey is willed where will is power."
        },
        {
          "section": "inf-04",
          "text": "Turns pale in Limbo, the circle that is his own home, and is greeted by the poets of antiquity."
        },
        {
          "section": "inf-05",
          "text": "Names the famous lovers in the storm for Dante, beginning with Semiramis and Dido."
        }
      ],
