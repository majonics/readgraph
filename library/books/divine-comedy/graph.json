    {
      "entity": "beatrice-portinari",
      "depth": 1,
      "importance": 3,
      "role": "The woman who sends Virgil to rescue Dante",
      "firstSection": "inf-02",
      "inBook": [
        {
          "section": "inf-02",
          "text": "Comes down from Heaven to Limbo and, in tears, asks Virgil to help Dante."
        }
      ],
      "media": []
    },
    {
      "entity": "charon",
      "depth": 1,
      "importance": 2,
      "role": "Ferryman of the Acheron, with eyes like burning coals",
      "firstSection": "inf-03",
      "inBook": [
        {
          "section": "inf-03",
          "text": "Refuses to carry a living man across until Virgil silences him."
        }
      ],
